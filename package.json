{
  "name": "sahaja-yoga-newsletter-studio",
  "version": "0.1.0",
  "description": "Private desktop newsletter studio for Sahaja Yoga event organisers",
  "author": "Sahaja Yoga Newsletter Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/nneupane1/sahaja-yoga-newsletter-studio.git"
  },
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "share:build": "vite build --config vite.share.config.ts",
    "dev:auth": "node scripts/auth-dev.mjs",
    "test:auth": "node --test tests/organiser-auth.test.mjs tests/session-database.test.mjs tests/asset-auth.test.mjs tests/auth-provider.test.mjs tests/share-preview.test.mjs",
    "desktop:dev": "pnpm desktop:build && electron .",
    "desktop:package:zip": "pnpm desktop:build && electron-builder --win zip --x64",
    "desktop:package:win": "pnpm desktop:build && electron-builder --win nsis zip --x64"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.115.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "build": {
    "appId": "org.sahajayoga.newsletterstudio",
    "productName": "Sahaja Yoga Newsletter Studio",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "desktop-dist/renderer/**/*",
      "package.json",
      "lib/*.mjs"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Sahaja-Yoga-Newsletter-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "desktop/build/icon.ico",
      "uninstallerIcon": "desktop/build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
