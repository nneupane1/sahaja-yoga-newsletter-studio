# Copy to .env.local in the repository root for local development.
# Values marked VITE_ are intentionally public browser configuration.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY
STUDIO_APP_ORIGIN=http://localhost:5173
# Replace these example addresses with the exact verified organiser emails.
# Maximum five. Empty means nobody has workspace access.
STUDIO_ORGANISER_EMAILS=nischal@example.org,bettina@example.org
# Optional: configure Google in Supabase before enabling this button.
VITE_GOOGLE_AUTH_ENABLED=false
# Recommended before public registration: enable Turnstile in Supabase and
# configure its matching public site key here. Its secret belongs in Supabase.
VITE_TURNSTILE_SITE_KEY=
# For the later Vercel deployment, STUDIO_APP_ORIGIN must instead be:
# https://sahaja-yoga-newsletter-studio.vercel.app
# Never add a Supabase service-role key, SMTP password or OAuth secret here.
